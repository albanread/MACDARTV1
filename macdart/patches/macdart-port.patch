+// MACDART workspace liveness: hot-reload the current isolate's sources. Re-reads
+// the root script and its imports through the tag handler (so a rewritten
+// scratch file is picked up), recompiles changed libraries, and morphs live
+// instances to the new class shapes (InstanceMorpher + Become). Returns null on
+// success, or an error handle whose message is the reload's cancellation report
+// (an unsafe structural change) — the workspace surfaces that and offers a
+// restart. See WORKSPACE_PLAN.md §5 and macdart/cocoa/workspace_natives.cc.
+DART_EXPORT Dart_Handle Dart_WorkspaceReloadSources(bool force_reload) {
+  // DARTSCOPE transitions this thread Native->VM (reload internally does its own
+  // VM->Native hop to call the tag handler, which asserts it starts in VM state).
+  DARTSCOPE(Thread::Current());
+  Isolate* isolate = T->isolate();
+  if (!isolate->CanReload()) {
+    return Api::NewError("%s: isolate cannot reload in its current state",
+                         CURRENT_FUNC);
+  }
+  JSONStream js;
+  bool success = isolate->ReloadSources(&js, force_reload);
+  if (!success) {
+    return Api::NewError("reload cancelled: %s", js.ToCString());
+  }
+  return Api::Success();
+}
