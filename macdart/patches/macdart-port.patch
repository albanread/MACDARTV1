+// MACDART workspace metrics: sample this isolate's live VM counters for the
+// toolbar (see dart_tools_api.h for the layout). Everything here is read
+// straight off the isolate's heap and compiler stats — nothing is derived or
+// estimated, so a counter the VM cannot answer stays 0 rather than showing a
+// plausible-looking guess. See macdart/cocoa/workspace_natives.cc.
+DART_EXPORT Dart_Handle Dart_WorkspaceVmStats(int64_t* out, intptr_t count) {
+  if ((out == NULL) || (count < kDartWorkspaceVmStatCount)) {
+    return Api::NewError("%s: expects room for %d counters", CURRENT_FUNC,
+                         kDartWorkspaceVmStatCount);
+  }
+  DARTSCOPE(Thread::Current());
+  Isolate* isolate = T->isolate();
+  Heap* heap = isolate->heap();
+  const int64_t word = kWordSize;
+
+  // NB Heap::UsedInWords maps every space except kNew onto old_space_, so
+  // asking it for kCode would silently answer the OLD-SPACE total. Generated
+  // code is accounted by the compiler stats below instead.
+  out[0] = heap->UsedInWords(Heap::kNew) * word;
+  out[1] = heap->CapacityInWords(Heap::kNew) * word;
+  out[2] = heap->UsedInWords(Heap::kOld) * word;
+  out[3] = heap->CapacityInWords(Heap::kOld) * word;
+  out[4] = heap->new_space()->collections();
+  out[5] = heap->old_space()->collections();
+
+  // Compiled behind FLAG_support_compiler_stats && FLAG_compiler_stats (see
+  // INC_STAT in vm/compiler_stats.h); zero unless the VM was started with
+  // --compiler_stats.
+  out[6] = out[7] = out[8] = 0;
+  if (FLAG_support_compiler_stats && FLAG_compiler_stats) {
+    CompilerStats* cs = isolate->aggregate_compiler_stats();
+    if (cs != NULL) {
+      out[6] = cs->num_functions_compiled;
+      out[7] = cs->num_functions_optimized;
+      out[8] = cs->total_instr_size;
+    }
+  }
+  return Api::Success();
+}
