"Feature test: integer / fraction / bignum / bit arithmetic. Expected values are
 the human-verified spec — factorials/powers checked against a reference."
STestCase subclass: TestNumerics [
    tests [
        self check: 12345 + 67890 is: 80235 label: 'int add'.
        self check: 99 * 99 is: 9801 label: 'int mul'.
        self check: 100 // 7 is: 14 label: 'int floordiv'.
        self check: 100 \\ 7 is: 2 label: 'int mod'.
        self check: 5 - 12 is: -7 label: 'int neg result'.
        self check: -7 abs is: 7 label: 'abs'.
        self check: (48 gcd: 36) is: 12 label: 'gcd'.
        self check: (4 lcm: 6) is: 12 label: 'lcm'.
        self check: (self fact: 10) is: 3628800 label: 'factorial 10'.
        self check: (self fact: 30) is: 265252859812191058636308480000000 label: 'factorial 30 (bignum)'.
        self check: (2 raisedTo: 64) is: 18446744073709551616 label: 'pow 2^64'.
        self check: (2 raisedTo: 100) is: 1267650600228229401496703205376 label: 'pow 2^100'.
        self check: ((1/3) + (1/6)) is: (1/2) label: 'fraction add reduces'.
        self check: ((2/4) = (1/2)) is: true label: 'fraction equality reduces'.
        self check: ((3/4) * (8/9)) is: (2/3) label: 'fraction mul reduces'.
        self check: ((7/2) truncated) is: 3 label: 'fraction truncated'.
        self check: (12 bitAnd: 10) is: 8 label: 'bitAnd'.
        self check: (12 bitOr: 3) is: 15 label: 'bitOr'.
        self check: (1 bitShift: 10) is: 1024 label: 'bitShift'.
        self check: (3 max: 7) is: 7 label: 'max'.
        self check: (5 between: 1 and: 10) is: true label: 'between'.
        self check: (17 rem: 5) is: 2 label: 'rem'.
        self check: (17 quo: 5) is: 3 label: 'quo'.
        self assert: 42 even label: 'even'.
        self deny: 42 isZero label: 'isZero'.
        self check: ((2 raisedTo: 60) byteAt: 8) is: 16 label: 'largeint byteAt'.

        "--- mixed native-int / Fraction arithmetic (the Dart coercion privates
         route to the ST protocol; division and // stay EXACT) ---"
        self check: 2 + (1/3) is: (7/3) label: 'int + fraction'.
        self check: 2 - (1/3) is: (5/3) label: 'int - fraction'.
        self check: 2 * (2/3) is: (4/3) label: 'int * fraction'.
        self check: 2 / (1/3) is: 6 label: 'int / fraction is exact'.
        self check: 7 // (2/3) is: 10 label: 'int // fraction floors'.
        self check: (2 > (1/3)) is: true label: 'int > fraction'.
        self check: ((1/3) + 2) is: (7/3) label: 'fraction + int (other order)'.

        "--- raisedTo: for every exponent (82_number_math) ---"
        self check: (2 raisedTo: 10) is: 1024 label: 'int pow stays exact'.
        self check: (2 raisedTo: -2) is: (1/4) label: 'negative pow -> exact Fraction'.
        self check: ((2/3) raisedTo: 3) is: (8/27) label: 'fraction pow stays exact'.
        self check: ((2 raisedTo: 0.5) - 2 sqrt) abs < 0.0000000001 is: true
            label: 'fractional pow ~ sqrt'.
        self check: (2 ** 8) is: 256 label: '** delegates to raisedTo:'.

        "--- the transcendental spellings ---"
        self check: (1.0 arcTan - 0.7853981633974483) abs < 0.0000000001 is: true
            label: 'arcTan'.
        self check: (0.5 arcSin - 0.5235987755982988) abs < 0.0000000001 is: true
            label: 'arcSin'.
        self check: (0.5 arcCos - 1.0471975511965976) abs < 0.0000000001 is: true
            label: 'arcCos'.
        self check: (2 sqrt - 1.4142135623730951) abs < 0.0000000001 is: true
            label: 'int sqrt'.
        self check: (0.5 sin - 0.479425538604203) abs < 0.0000000001 is: true
            label: 'double sin'.
    ]
    fact: n [ n <= 1 ifTrue: [ ^1 ]. ^n * (self fact: n - 1) ]
]
